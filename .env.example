# IPv6 Sentinel Safe example configuration
IPV6_SENTINEL_HOST=127.0.0.1
IPV6_SENTINEL_PORT=5000
IPV6_SENTINEL_DEBUG=0

# Turn this on when exposing the UI beyond your own local desktop.
IPV6_SENTINEL_WEB_AUTH_ENABLED=0
IPV6_SENTINEL_USERNAME=admin
# Do not commit a real password. Docker Compose requires this value to be set explicitly.
IPV6_SENTINEL_PASSWORD=

# Keep CORS explicit. Do not use * unless this is a controlled local lab.
IPV6_SENTINEL_CORS=http://127.0.0.1:5000,http://localhost:5000
IPV6_SENTINEL_ALLOW_INSECURE_REMOTE=0

IPV6_SENTINEL_LOG_LEVEL=INFO
IPV6_SENTINEL_UPDATE_INTERVAL=3
IPV6_SENTINEL_SOCKETIO_PING_TIMEOUT=60
IPV6_SENTINEL_SOCKETIO_PING_INTERVAL=25

# Runtime data directory. Keep the default for normal local demos.
# Tests can set this to a temporary directory so runtime data never dirties the source tree.
IPV6_SENTINEL_DATA_DIR=data

# Set to 0 for quiet test/review sessions that should not create local log files.
IPV6_SENTINEL_LOG_CONSOLE_ENABLED=1
IPV6_SENTINEL_LOG_FILE_ENABLED=1
